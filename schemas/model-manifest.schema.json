{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment-models.github.io/assessment-ci/schemas/model-manifest.schema.json",
  "title": "Model Repository Manifest (model.yaml)",
  "description": "Root manifest every Assessment-Models model repository carries (CR-AM-11 section 22): identity, version, contract dependency, components, dependencies, compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "version", "conformance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Canonical model identifier."
    },
    "type": {
      "type": "string",
      "enum": ["maturity-model", "assessment-model", "assessment-tool"]
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?$",
      "description": "Model version (SemVer). Matches the git tag vX.Y.Z at release."
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "source", "version"],
      "description": "The contract handshake (CR-AM-11 section 15). Machine-readable; CI resolves and validates the declared version.",
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "minLength": 1}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization", "repository"],
          "properties": {
            "organization": {"type": "string"},
            "repository": {"type": "string"}
          }
        },
        "version": {
          "type": "string",
          "description": "Declared supported contract version (e.g. \"1.0\", \"^1.0\")."
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Reusable component references (CR-AM-11 section 20). Every reference carries kind + immutable reference.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "kind", "source", "version", "reference"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "type": {
            "type": "string",
            "enum": ["dimension", "sub-dimension", "capability", "criterion", "indicator", "evidence-requirement", "level-expectation"]
          },
          "kind": {
            "type": "string",
            "enum": ["import", "extend", "override"],
            "description": "Reference kind (CR-AM-10 section 4). Kindless references are refused - no silent inheritance."
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository"],
            "properties": {
              "repository": {"type": "string"}
            }
          },
          "version": {"type": "string"},
          "reference": {"type": "string", "description": "Immutable: tag vX.Y.Z, 40-char SHA, or sha256 digest."}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Other registered assets this model depends on, with immutable references.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reference"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "reference": {"type": "string", "description": "Immutable: tag vX.Y.Z, 40-char SHA, or sha256 digest."}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "description": "Compatibility declaration (CR-AM-11 section 17).",
      "properties": {
        "metamodel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {"type": "string"},
            "maximum": {"type": "string"}
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
